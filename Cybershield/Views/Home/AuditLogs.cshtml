@model List<Cybershield.Models.AuditLogRecord>
@{
    ViewData["Title"] = "Security Audit Logs";
}
<div class="container mt-4">
    <div class="card shadow p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold mb-0">SYSTEM SECURITY AUDIT LOGS</h3>
            <a href="/Home/Index" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Audit ID</th>
                        <th>Actor User ID</th>
                        <th>Action Performed</th>
                        <th>Details</th>
                        <th>Timestamp (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var log in Model)
                        
                        {
                            <tr>
                                <td class="fw-bold">@log.AuditId</td>
                                <td>@(log.ActorUserId.HasValue ? log.ActorUserId.Value.ToString() : "System / Guest")</td>
                                <td><span class="badge bg-info text-dark">@log.Action</span></td>
                                <td class="text-break">@log.Details</td>
                                <td class="small text-muted">@log.CreatedAt</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No audit logs recorded yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>