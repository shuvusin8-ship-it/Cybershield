@{
    ViewData["Title"] = "Officer Account Activation";
}
<div class="container mt-4" style="max-width: 550px;">
    <div class="card shadow p-4">
        <h3 class="text-center fw-bold">OFFICER ACCOUNT ACTIVATION</h3>
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        <form method="post" action="/Home/OfficerRegister">
            <div class="mb-2"><label>Full Name</label><input type="text" name="fullName" class="form-control" required /></div>
            <div class="mb-2"><label>Official Email</label><input type="email" name="email" class="form-control" required /></div>
            <div class="mb-2"><label>Mobile</label><input type="text" name="mobile" class="form-control" required /></div>
            <div class="mb-2"><label>Employee ID</label><input type="text" name="employeeId" class="form-control" required /></div>
            <div class="mb-2"><label>Invitation Token</label><input type="text" name="token" class="form-control" required /></div>
            <div class="mb-2"><label>Password</label><input type="password" name="password" class="form-control" required /></div>
            <div class="mb-3"><label>Confirm Password</label><input type="password" name="confirmPassword" class="form-control" required /></div>
            <button type="submit" class="btn btn-primary w-100 fw-bold mb-2">Activate Officer Account</button>
            <a href="/Home/Login" class="btn btn-secondary w-100">Back to Login</a>
        </form>
    </div>
</div>