@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Register Complaint";
}
<div class="container mt-4" style="max-width: 720px;">
    <div class="card shadow p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold mb-0">Register Cybercrime Complaint</h3>
            <a href="/Home/Index" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
        </div>

        @if (ViewBag.Success != null) { <div class="alert alert-success fw-bold">@ViewBag.Success</div> }
        @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }

        <form method="post" action="/Home/Complaint" enctype="multipart/form-data">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Nearest Cyber Cell / Jurisdiction</label>
                    <select name="cyberZone" class="form-select" required>
                        @foreach (var z in Cybershield.Models.DatabaseService.CyberZones)
                        {
                            <option value="@z">@z</option>
                        }
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Crime Type</label>
                    <select name="crimeType" id="crimeTypeSelect" class="form-select" onchange="toggleFinancialFields()" required>
                        <option value="">-- Select Crime Type --</option>
                        <option value="Online Fraud">Online Fraud (Financial)</option>
                        <option value="Phishing">Phishing Attack</option>
                        <option value="Hacking">Account / System Hacking</option>
                        <option value="Identity Theft">Identity Theft</option>
                        <option value="Cyberbullying">Cyberbullying / Harassment</option>
                        <option value="Fake Profile">Fake Profile / Impersonation</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Incident Date</label>
                    <input type="date" name="complaintDate" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Suspect Mobile / UPI ID / URL</label>
                    <input type="text" name="suspectIdentifier" class="form-control" placeholder="e.g. 9876543210 or scam@upi" />
                </div>
            </div>

            <div id="financialFields" class="row p-3 mb-3 border border-danger rounded bg-light" style="display:none;">
                <h6 class="fw-bold text-danger mb-2">🚨 1930 Golden-Hour Financial Fraud Details (₹10,000+ within 24h triggers Instant Freeze Alert)</h6>
                <div class="col-md-6 mb-2">
                    <label class="form-label">Amount Lost (₹)</label>
                    <input type="number" step="0.01" name="amountLost" class="form-control" value="0" />
                </div>
                <div class="col-md-6 mb-2">
                    <label class="form-label">Bank Transaction / UTR Number</label>
                    <input type="text" name="transactionId" class="form-control" placeholder="12-digit UTR / Ref No." />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Incident Description</label>
                <textarea name="description" class="form-control" rows="4" maxlength="4000" required></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Upload Screenshot / Digital Proof (Optional)</label>
                <input type="file" name="proofFile" class="form-control" />
                <small class="text-muted">Automatically hashed with SHA-256 for court admissibility.</small>
            </div>

            <button type="submit" class="btn btn-primary w-100 fw-bold py-2">Submit Complaint & Notify Nearest Cyber Cell</button>
        </form>
    </div>
</div>

<script>
    function toggleFinancialFields() {
        var type = document.getElementById("crimeTypeSelect").value;
        document.getElementById("financialFields").style.display = (type === "Online Fraud" || type === "Phishing") ? "flex" : "none";
    }
</script>