@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow p-4">
        <h3 class="text-center fw-bold">CYBERCRIME MANAGEMENT SYSTEM</h3>
        <p class="text-muted text-center small">Sign in with your registered email address or mobile number</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" action="/Home/Login">
            <div class="mb-3">
                <label class="form-label">Email / Mobile</label>
                <input type="text" name="identifier" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-dark w-100 fw-bold mb-3">LOGIN</button>
        </form>

        <div class="d-flex justify-content-between">
            <a href="/Home/Register" class="btn btn-outline-primary btn-sm">Create User Account</a>
            <a href="/Home/OfficerRegister" class="btn btn-outline-secondary btn-sm">Officer Account Activation</a>
            <a href="/Home/AnonymousTip" class="btn btn-outline-danger w-100 mt-2 fw-bold">🕵️ Submit Anonymous Cyber Tip-Off (Whistleblower)</a>
        </div>
    </div>
</div>